# Optional Gemini integration (not required for core registry/gate tests).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL used by hosted deployments where needed.
APP_URL="MY_APP_URL"

# Optional PostgreSQL/PostGIS connection.
# IMPORTANT: setting DATABASE_URL enables connectivity/migration readiness only.
# The API remains MEMORY_UI_DEMO until the canonical Postgres repository adapter
# is implemented and integration-tested.
DATABASE_URL="postgresql://user:password@host:5432/national_hiking"

# Runtime environment.
NODE_ENV="development"
PORT="3000"
