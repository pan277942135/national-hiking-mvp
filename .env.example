# Optional Gemini integration (not required for core registry/gate tests).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL used by hosted deployments where needed.
APP_URL="MY_APP_URL"

# Optional PostgreSQL/PostGIS connection.
# When configured and reachable, /api/canonical/* reads canonical Postgres truth.
# The legacy presentation UI endpoints remain MEMORY_UI_DEMO until an explicit
# product switch replaces them with canonical read models.
DATABASE_URL="postgresql://user:password@host:5432/national_hiking"

# Canonical mutation APIs are internal/editorial only.
# If this value is absent, POST /api/canonical/* mutation endpoints fail closed.
# Authorized callers send: Authorization: Bearer <CANONICAL_WRITE_TOKEN>
CANONICAL_WRITE_TOKEN="replace-with-a-long-random-secret"

# Runtime environment.
NODE_ENV="development"
PORT="3000"
